;;; Commentary:
;;;
;;; Content-aware pruning of the generated stylesheet.  The pruner scans a
;;; directory of built HTML for the utility classes that are actually used,
;;; parses the compiled stylesheet into nested blocks, and keeps only the rules
;;; whose selectors match a used class.
;;;
;;; Every path and search option is a Guile parameter, so a build can be
;;; customized with @code{parameterize} instead of editing this module:
;;;
;;;   (parameterize ((artifact-path "_site")
;;;                  (base-stylesheet-path "resources/css/olive.min.css")
;;;                  (output-css-target "app.min.css"))
;;;     (tree-shake))
;;;
;;; The command-line front-end is @code{olive-css tree-shake}, from
;;; @code{(olive-css cli)}.
;;;
;;;
;;; Code:

(define-module (olive-css tree-shaking)
  #:use-module (srfi srfi-1)
  #:use-module (ice-9 ftw)
  #:use-module (ice-9 format)
  #:use-module (ice-9 regex)
  #:use-module (ice-9 string-fun)
  #:use-module (ice-9 textual-ports)
  #:use-module (olive-css license)
  #:export (base-stylesheet-path artifact-path
                                 output-css-target
                                 scanned-file-types
                                 skipped-directories
                                 scan-mode
                                 preserved-classes
                                 preserved-patterns
                                 escape-class-name
                                 unescape-class-name
                                 extract-classes-from-html
                                 html-classes
                                 sxml-classes
                                 mode-extractors
                                 scan-used-classes
                                 parse-css-blocks
                                 serialize-css-blocks
                                 tree-shake-css
                                 tree-shake))

;;; ---------------------------------------------------------------------------
;;; Options
;;; ---------------------------------------------------------------------------

;; The pre-built stylesheet to prune.  It is the output of the generator
;; (`olive-css-gen.scm' / `write-css-to-file').
(define base-stylesheet-path
  (make-parameter "resources/css/olive.min.css"))

;; The directory containing the build artifacts (e.g., generated by Hugo or
;; Zola).  Its scanned files are searched for the utility classes that are
;; actually utilized in the final site.
(define artifact-path
  (make-parameter "public"))

;; The path for the optimized, tree-shaken CSS output.  This target resolves
;; relative to ARTIFACT-PATH.
;;
;; Example:
;;   ARTIFACT-PATH: "public"
;;   OUTPUT-CSS-TARGET: "olive.min.css"
;;   Final Destination: "public/olive.min.css"
(define output-css-target
  (make-parameter "olive.min.css"))

;; The file name suffixes considered when scanning for used classes.
(define scanned-file-types
  (make-parameter '(".html" ".htm")))

;; Directories that are never descended into while scanning.
(define skipped-directories
  (make-parameter '(".git")))

;; What a scan understands:
;;
;;   html      `class="..."' and `className="..."' in the scanned files
;;   sxml      the same plus SXML `(@ (class "..."))' attributes, which is how
;;             Artanis, Guile's own templates and any SXML generator write them
;;   manifest  no scanning at all: the classes come from `preserved-classes',
;;             for an application that builds its class names at run time
;;
;; A dynamic application usually needs one of the last two: a template that
;; computes `text-<colour>-500' cannot be scanned, so the build either names the
;; classes it renders or keeps them by pattern.
(define scan-mode
  (make-parameter 'html))

;; Classes to keep whatever the scan finds.  Written the way the markup writes
;; them (`bg-x/50', not `bg-x\/50').
(define preserved-classes
  (make-parameter '()))

;; Regular expressions a class name has to match to be kept, for the families a
;; scan cannot enumerate (`text-.*-500', `col-span-.*').  Matched against the
;; class name as the markup writes it.
(define preserved-patterns
  (make-parameter '()))

;;; ---------------------------------------------------------------------------
;;; HTML scanning
;;; ---------------------------------------------------------------------------

(define (escape-class-name name)
  "Escape NAME the way a CSS selector escapes it, e.g. \"hover:bg-white\"
becomes \"hover\\:bg-white\" and \"mask-t-from-50%\" becomes
\"mask-t-from-50\\%\"."
  (fold (lambda (replacement acc)
          (string-replace-substring acc
                                    (car replacement)
                                    (cdr replacement))) name
        '((":" . "\\:") ("/" . "\\/") ("%" . "\\%") ("@" . "\\@"))))

(define (unescape-class-name name)
  "NAME with the CSS escapes removed, i.e. the way the markup wrote it."
  (let loop
    ((chars (string->list name))
     (acc '()))
    (cond
      ((null? chars)
       (list->string (reverse acc)))
      ((and (char=? (car chars) #\\) (pair? (cdr chars)))
       (loop (cddr chars)
             (cons (cadr chars) acc)))
      (else (loop (cdr chars)
                  (cons (car chars) acc))))))

;; `class=' and `className=' (JSX and friends).  The two alternatives are
;; ordered longest-first, because POSIX matches the longest one.
(define class-attribute-regexp
  (make-regexp
   "(className|class)[[:space:]]*=[[:space:]]*[\"']([^\"']*)[\"']"
   regexp/extended))

;; SXML writes an attribute as `(@ (class "a b"))', which the HTML form above
;; does not see because the quotes are inside the list.
(define sxml-class-regexp
  (make-regexp "\\(class[[:space:]]+\"([^\"]*)\"" regexp/extended))

(define* (extract-with regexp text #:key (group 1))
  "The escaped class names the capturing GROUP of REGEXP matches in TEXT."
  (let loop
    ((start 0)
     (acc '()))
    (let ((matched (regexp-exec regexp text start)))
      (if matched
          (loop (match:end matched)
                (append (map escape-class-name
                             (string-tokenize (match:substring matched group)))
                        acc))
          acc))))

(define (html-classes text)
  "The class names a document's class attributes reference."
  (extract-with class-attribute-regexp text #:group 2))

(define (sxml-classes text)
  "The class names a document references, in HTML or in SXML form."
  (append (html-classes text)
          (extract-with sxml-class-regexp text)))

(define (mode-extractors)
  "The extractors the current `scan-mode' applies to every file it reads."
  (case (scan-mode)
    ((html) (list html-classes))
    ((sxml) (list sxml-classes))
    ((manifest) '())
    (else (error "unknown scan mode" (scan-mode)))))

(define (extract-classes-from-html file-path)
  "Return the (escaped) class names referenced by the `class' attributes of the
HTML file at FILE-PATH."
  (html-classes (call-with-input-file file-path
                  get-string-all)))

(define (scan-used-classes base-dir)
  "Recursively traverse BASE-DIR to find every unique CSS class name used in
the files matching `scanned-file-types'.  Returns a list of escaped class names,
e.g. 'bg-apple-green-100\\/50' or 'hover\\:bg-white'.

`scan-mode' decides what each file is read for; the `manifest' mode reads
nothing and returns the empty list."
  (define (enter? path stat result)
    (not (member (basename path)
                 (skipped-directories))))
  (define (leaf path stat result)
    (if (any (lambda (extension)
               (string-suffix? extension path))
             (scanned-file-types))
        (let ((text (call-with-input-file path
                      get-string-all)))
          (append (append-map (lambda (extractor)
                                (extractor text))
                              (mode-extractors))
                  result)) result))
  (define (down path stat result)
    result)
  (define (up path stat result)
    result)
  (define (skip path stat result)
    result)
  (define (error name stat errno result)
    (format (current-error-port) "warning: ~a: ~a~%" name
            (strerror errno)) result)
  (let ((raw (file-system-fold enter?
                               leaf
                               down
                               up
                               skip
                               error
                               '()
                               base-dir)))
    (delete-duplicates (filter (lambda (s)
                                 (not (or (string-null? s)
                                          (string=? s "\n")))) raw))))

;;; ---------------------------------------------------------------------------
;;; Minimal CSS block parser
;;;
;;; The parser only needs to understand rule structure, not declarations.  A
;;; block is represented as a pair (SELECTOR . INNER), where INNER is the raw
;;; text between the braces, or #f for at-rules without a block (e.g. @charset).
;;; ---------------------------------------------------------------------------

(define (matching-brace s open-idx)
  "Return the index of the `}' matching the `{' at OPEN-IDX in S."
  (let loop
    ((i (+ open-idx 1))
     (depth 1))
    (cond
      ((>= i
           (string-length s))
       (string-length s))
      ((char=? (string-ref s i) #\{)
       (loop (+ i 1)
             (+ depth 1)))
      ((char=? (string-ref s i) #\})
       (if (= depth 1) i
           (loop (+ i 1)
                 (- depth 1))))
      (else (loop (+ i 1) depth)))))

(define (parse-css-blocks s)
  "Parse the sequence of blocks at one nesting level of S."
  (let loop
    ((i 0)
     (acc '()))
    (let ((n (string-length s)))
      (cond
        ((>= i n)
         (reverse acc))
        ((char-whitespace? (string-ref s i))
         (loop (+ i 1) acc))
        ((and (< (+ i 1) n)
              (char=? (string-ref s i) #\/)
              (char=? (string-ref s
                                  (+ i 1)) #\*))
         (let ((end (string-contains s "*/"
                                     (+ i 2))))
           (loop (if end
                     (+ end 2) n) acc)))
        (else (let* ((brace (string-index s #\{ i))
                     (semi (string-index s #\; i))
                     (has-block (and brace
                                     (or (not semi)
                                         (< brace semi))))
                     (end (if has-block brace
                              (if semi semi n))))
                (if (not has-block)
                    (loop (if semi
                              (+ semi 1) n)
                          (cons (cons (string-trim-both (substring s i end))
                                      #f) acc))
                    (let* ((sel (string-trim-both (substring s i brace)))
                           (close (matching-brace s brace))
                           (inner (substring s
                                             (+ brace 1) close)))
                      (loop (+ close 1)
                            (cons (cons sel inner) acc))))))))))

(define (serialize-css-blocks nodes)
  "Serialize a list of parsed blocks back into minified CSS text."
  (string-join (map (lambda (node)
                      (if (cdr node)
                          (format #f "~a{~a}"
                                  (car node)
                                  (cdr node))
                          (format #f "~a;"
                                  (car node)))) nodes) ""))

;;; ---------------------------------------------------------------------------
;;; Selector analysis
;;; ---------------------------------------------------------------------------

(define (split-selectors sel)
  "Split a selector list SEL on top-level commas (ignoring :where(a, b))."
  (let loop
    ((chars (string->list sel))
     (depth 0)
     (cur '())
     (acc '()))
    (cond
      ((null? chars)
       (reverse (cons (list->string (reverse cur)) acc)))
      ((char=? (car chars) #\()
       (loop (cdr chars)
             (+ depth 1)
             (cons (car chars) cur) acc))
      ((char=? (car chars) #\))
       (loop (cdr chars)
             (max 0
                  (- depth 1))
             (cons (car chars) cur) acc))
      ((and (char=? (car chars) #\,)
            (= depth 0))
       (loop (cdr chars) depth
             '()
             (cons (list->string (reverse cur)) acc)))
      (else (loop (cdr chars) depth
                  (cons (car chars) cur) acc)))))

(define (read-class-name sel j)
  "Return the exclusive end index of the class name starting at J in SEL."
  (cond
    ((>= j
         (string-length sel))
     j)
    ((char=? (string-ref sel j) #\\)
     (if (< (+ j 1)
            (string-length sel))
         (read-class-name sel
                          (+ j 2))
         (+ j 1)))
    ((or (char-alphabetic? (string-ref sel j))
         (char-numeric? (string-ref sel j))
         (memv (string-ref sel j)
               '(#\- #\_)))
     (read-class-name sel
                      (+ j 1)))
    (else j)))

(define (class-tokens sel)
  "Return the (escaped) class names referenced in a simple selector SEL."
  (let loop
    ((i 0)
     (acc '()))
    (if (>= i
            (string-length sel))
        (reverse acc)
        (if (char=? (string-ref sel i) #\.)
            (let ((end (read-class-name sel
                                        (+ i 1))))
              (loop end
                    (cons (substring sel
                                     (+ i 1) end) acc)))
            (loop (+ i 1) acc)))))

(define (marker-class? token)
  "True when TOKEN only marks the element a variant watches.

`group' and `peer' (and their named forms, `group\\/sidebar') appear in the
selectors of every group and peer variant, but the site writes them on a
different element than the utility.  Keeping a rule because of them would keep
every variant a page ever generated."
  (and (or (string=? token "group")
           (string=? token "peer")
           (string-prefix? "group\\/" token)
           (string-prefix? "peer\\/" token)) #t))

(define (class-kept? token used patterns)
  "True when TOKEN is used, or matches one of the PATTERNS."
  (or (member token used)
      (any (lambda (pattern)
             (regexp-exec pattern (unescape-class-name token))) patterns)))

(define (part-used? part used patterns)
  "True when PART is classless (reset/structural) or references a class the
site uses.

A selector with several classes needs only one of them to be used - the utility
class - because the others name the context (`:where', `:not', the ancestor of a
group variant).  Marker classes are the exception: they never decide alone."
  (let ((tokens (remove marker-class? (class-tokens part))))
    (or (null? tokens)
        (any (lambda (token)
               (class-kept? token used patterns)) tokens))))

;;; ---------------------------------------------------------------------------
;;; Filtering
;;; ---------------------------------------------------------------------------

(define (filter-blocks nodes used patterns)
  "Keep only nodes of NODES that are relevant to USED class names or PATTERNS."
  (filter-map (lambda (node)
                (filter-block node used patterns)) nodes))

(define (grouping-at-rule? sel)
  "True when SEL opens a block whose children are rules rather than
declarations, so the pruner has to descend instead of judging the prelude.

Every at-rule but @code{@keyframes} and @code{@view-transition} qualifies:
those two name their content indirectly and are kept whole."
  (and (string-prefix? "@" sel)
       (not (string-prefix? "@keyframes" sel))
       (not (string-prefix? "@view-transition" sel))))

(define (filter-block node used patterns)
  (let ((sel (car node))
        (inner (cdr node)))
    (cond
      ;; at-rules without a block are always kept.
      ((not inner)
       node)
      ;; keyframes and view transitions are tiny and referenced indirectly.
      ((or (string-prefix? "@keyframes" sel)
           (string-prefix? "@view-transition" sel))
       node)
      ;; grouping rules: recurse and drop the group when it becomes empty.
      ((or (grouping-at-rule? sel)
           (string-prefix? ":where" sel)
           (string-prefix? ":is" sel))
       (let ((kept (filter-blocks (parse-css-blocks inner) used patterns)))
         (if (null? kept) #f
             (cons sel
                   (serialize-css-blocks kept)))))
      (else (let ((parts (filter (lambda (part)
                                   (part-used? part used patterns))
                                 (split-selectors sel))))
              (if (null? parts) #f
                  (cons (string-join parts ",") inner)))))))

(define (license-comment)
  "Return the pruned stylesheet's license comment, or the empty string when the
`license-header' parameter is empty."
  (let ((header (string-join (string-tokenize (license-header)) " ")))
    (if (string-null? header) ""
        (format #f "/*~a*/" header))))

(define* (tree-shake-css css used #:key (patterns (preserved-patterns)))
  "Return a minified stylesheet containing only the rules relevant to USED.

PATTERNS is a list of regular expressions; a class name that matches one is kept
even when no scan found it, which is how a build prunes an application whose
class names are computed at run time."
  (let ((compiled (map (lambda (pattern)
                         (make-regexp pattern))
                       patterns)))
    (string-append (license-comment)
                   (serialize-css-blocks (filter-blocks (parse-css-blocks css)
                                                        used compiled)))))

;;; ---------------------------------------------------------------------------
;;; Entry-point
;;; ---------------------------------------------------------------------------

(define* (tree-shake #:key stylesheet directory target)
  "Prune the stylesheet at STYLESHEET (default: `base-stylesheet-path') down to
the classes used under DIRECTORY (default: `artifact-path'), writing the result
to TARGET (default: `output-css-target') inside that directory.

Returns an association list describing the run: the input stylesheet, the
destination written, the number of used classes and the byte sizes before and
after pruning."
  (let* ((stylesheet (or stylesheet
                         (base-stylesheet-path)))
         (directory (or directory
                        (artifact-path)))
         (target (or target
                     (output-css-target)))
         (css (call-with-input-file stylesheet
                get-string-all))
         ;; Declared classes count as used: a scan cannot see a name the
         ;; application builds at run time.
         (used-classes (delete-duplicates (append (map escape-class-name
                                                       (preserved-classes))
                                                  (scan-used-classes
                                                   directory))))
         (output (tree-shake-css css used-classes))
         (destination (in-vicinity directory target)))
    (call-with-output-file destination
      (lambda (out-port)
        (display output out-port)))
    `((stylesheet unquote stylesheet)
      (destination unquote destination)
      (mode unquote
            (scan-mode))
      (used-classes unquote
                    (length used-classes))
      (input-bytes unquote
                   (string-length css))
      (output-bytes unquote
                    (string-length output)))))
