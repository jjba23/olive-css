# syntax=docker/dockerfile:1.7

# olive-css
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends guile; \
    zypper clean --all

COPY src/olive-css ./src/olive-css

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/olive-css"; \
    cp -r "src/olive-css/." "$site/olive-css/"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="olive-css" \
      org.opencontainers.image.description="Utility-first CSS framework written in Guile Scheme" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/olive-css" \
      org.opencontainers.image.licenses="LGPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site/3.0/olive-css /usr/share/guile/site/3.0/olive-css

ENTRYPOINT ["guile"]
