pkgname=olive-css
pkgver=1.1.0
pkgrel=1
pkgdesc="Utility-class CSS framework written in Guile Scheme"
arch=('any')
url="https://github.com/jjba23/olive-css"
license=('MIT')

depends=(
  'guile'
)

makedepends=(
  'guile'
  'pkgconf'
)

checkdepends=(
  'veritas'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# `maak release' fills this in from the archive the new tag serves.
sha256sums=('020749e1364c8a9c4d013e8bfffa5eb784f7f832e249281eb7e91f1014d9a185')

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/olive-css"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/olive-css"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/olive-css -name '*.scm')
}

check() {
  cd "$srcdir/olive-css"

  VERITAS_TEST_TYPE=unit VERITAS_RUN_BENCHMARKS=false guile --fresh-auto-compile -L ./src -L ./test -L . -c '((@ (veritas runner) run-tests))'
}

package() {
  cd "$srcdir/olive-css"

  site_dir="$(_site_dir)"
  install -d "$pkgdir${site_dir}/olive-css"
  cp -r src/olive-css/. "$pkgdir${site_dir}/olive-css/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/olive-css"
  cp -r "$srcdir/ccache/olive-css/." "$pkgdir${ccache_dir}/olive-css/"

  install -Dm755 bin/olive-css "$pkgdir/usr/bin/olive-css"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 CHANGELOG.org "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.org"
  for doc in docs/*.org; do
    install -Dm644 "$doc" "$pkgdir/usr/share/doc/$pkgname/docs/$(basename "$doc")"
  done
}
